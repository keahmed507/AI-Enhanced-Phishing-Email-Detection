# Copy this file to .env and fill in real values before deploying.
# app.py reads these from the actual process environment — how you get
# them there depends on your host (see README.md "Deploying this").

# Never "1" in production — enables Flask's interactive debugger.
FLASK_DEBUG=0

# Comma-separated list of origins allowed to call this API.
# Example: https://your-username.github.io,https://your-domain.com
ALLOWED_ORIGINS=*

# Shared secret required in the X-API-Key header on /api/analyze.
# Leave unset to run without auth (fine for a local demo only).
API_KEY=

# Requests per minute allowed per client IP.
RATE_LIMIT=30/minute

# Port to listen on. Most hosting platforms (Render, Railway, etc.)
# set this automatically — you usually don't need to touch it.
PORT=5000
